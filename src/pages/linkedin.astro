---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import CookieConsent from "../components/CookieConsent.astro";


---

<!DOCTYPE html>
<html lang="en">

<head>
  <GoogleAnalytics />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>LinkedIn Updates | ErsSoft Limited</title>
  <!-- Theme & Icons -->
  <meta name="theme-color" content="#0b1020">

  <link rel="icon" type="image/png" sizes="32x32"
        href="/assets/favicon-32x32.png">

  <link rel="icon" type="image/png" sizes="16x16"
        href="/assets/favicon-16x16.png">

  <link rel="apple-touch-icon" sizes="180x180"
        href="/assets/apple-touch-icon.png">

  <!-- SEO -->
  <meta name="description"
        content="Explore the latest LinkedIn updates, industry insights and company news from ErsSoft Limited.">

  <meta name="robots" content="index, follow">

  <link rel="canonical"
        href="https://www.erssoft.co.uk/linkedin/">

  <!-- Open Graph -->
  <meta property="og:title"
        content="LinkedIn Updates | ErsSoft Limited">

  <meta property="og:description"
        content="Company updates and technology insights from ErsSoft Limited.">

  <meta property="og:type" content="website">

  <meta property="og:url"
        content="https://www.erssoft.co.uk/linkedin/">

  <meta property="og:image"
        content="https://www.erssoft.co.uk/assets/logo.png">

  <!-- Shared CSS -->
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">

  <!-- LinkedIn CSS -->
  <link rel="stylesheet" href="/css/linkedin.css">

</head>

<body>

  <!-- Shared Header -->
  <Header />

  <main class="linkedin-page">

    <!-- Compact Introduction -->
    <section
      class="linkedin-intro"
      aria-labelledby="linkedin-title"
    >

      <div class="linkedin-intro__copy">

        <h1 id="linkedin-title">
          LinkedIn Updates
        </h1>

        <p>
          Company news, technology insights and industry
          updates from ErsSoft Limited.
        </p>

      </div>

      <!-- Follow Button -->
      <a
        href="https://www.linkedin.com/company/77574975/"
        target="_blank"
        rel="noopener noreferrer"
        class="linkedin-follow"
      >
        Follow us on LinkedIn ↗
      </a>

    </section>

    <!-- LinkedIn Posts -->
    <section
      class="linkedin-section"
      aria-labelledby="linkedin-posts-title"
    >

      <div class="linkedin-section-header">

        <h2 id="linkedin-posts-title">
          Latest Posts
        </h2>

      </div>

      <!-- Loading / Error Status -->
      <div
        id="linkedin-status"
        class="linkedin-status"
        role="status"
        aria-live="polite"
      >
        Loading LinkedIn updates...
      </div>

      <!-- Posts Grid -->
      <div
        id="linkedin-posts"
        class="linkedin-grid"
        aria-live="polite"
        hidden
      ></div>

      <!-- Pagination -->
      <div
        id="linkedin-pagination"
        class="linkedin-pagination"
        hidden
      >

        <button
          id="linkedin-prev"
          type="button"
          aria-label="Previous posts"
        >
          &#8592;
        </button>

        <span
          id="linkedin-page-counter"
          aria-live="polite"
        ></span>

        <button
          id="linkedin-next"
          type="button"
          aria-label="Next posts"
        >
          &#8594;
        </button>

      </div>

    </section>

  </main>

  <!-- Shared Footer -->
  <Footer />
  <CookieConsent />
  <!-- Shared Components -->
  

  <!-- LinkedIn Posts -->
  <script src="/js/linkedin.js" defer></script>

</body>
</html>
