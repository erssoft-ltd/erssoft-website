---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <GoogleAnalytics />
  <meta charset="UTF-8" />
 <!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
 <title>Thank You | ErsSoft Limited</title>
  <meta name="description" content="Thank you for contacting ErsSoft Limited. Our ERP and JD Edwards consultants will be in touch shortly." />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="stylesheet" href="/css/common.css">
<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/footer.css">
<link rel="stylesheet" href="/css/thankyou.css">
</head>

<body>

<Header />
<div class="page-content">

<section class="section">
  <div class="thankyou-box">
    <h1>Thank you for contacting ErsSoft</h1>
    <p>
      Your enquiry has been successfully submitted and received by our senior ERP consulting team.
    </p>
    <p>
      One of our consultants will review your request and contact you within <strong>1 business day</strong>
      to discuss your ERP, JD Edwards, or digital transformation requirements.
    </p>
    <p>
        In the meantime, you may explore how ErsSoft helps companies
        streamline operations, improve reporting, and scale with confidence.
    </p>
    <div class="cta">
      <a href="/services/">View Our Services</a>
      <a href="/" class="secondary">Return to Homepage</a>
    </div>
  </div>
</section>

</div>
<Footer />


</body>
</html>
