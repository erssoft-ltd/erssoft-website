---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const articles=await getCollection('insights');return articles.map(article=>({params:{slug:article.id},props:{article}}));}
const { article }=Astro.props;
const { Content }=await render(article);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{article.data.title} | ERSSOFT Limited</title><meta name="description" content={article.data.description}/><link rel="stylesheet" href="/css/common.css"/><link rel="stylesheet" href="/css/header.css"/><link rel="stylesheet" href="/css/footer.css"/><link rel="stylesheet" href="/css/blog.css"/></head><body><Header/><main class="blog-wrap blog-article"><a href="/insights/" class="blog-back">← All insights</a><div class="blog-eyebrow">{article.data.category}</div><h1>{article.data.title}</h1><p class="insights-byline">{article.data.author} · {article.data.date.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</p><div class="insights-body"><Content /></div><p class="blog-signoff">ERSSOFT Limited · ERP &amp; JD Edwards Consulting</p><a href="/insights/" class="blog-back">← Back to Insights</a></main><Footer/></body></html>
