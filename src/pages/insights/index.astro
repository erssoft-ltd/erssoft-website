---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('insights')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const categories = ['All', 'JD Edwards', 'ERP Consulting', 'Integration', 'Business Intelligence', 'Artificial Intelligence'];
---
<!doctype html><html lang="en"><head>
  <title>Insights & Expertise | ERSSOFT Limited</title>
  <meta name="description" content="ERSSOFT technical insights and articles on JD Edwards, ERP consulting, integration, business intelligence and artificial intelligence." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.erssoft.co.uk/insights/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ERSSOFT Limited" />
  <meta property="og:title" content="Insights & Expertise | ERSSOFT Limited" />
  <meta property="og:description" content="ERSSOFT technical insights and articles on JD Edwards, ERP consulting, integration, business intelligence and artificial intelligence." />
  <meta property="og:url" content="https://www.erssoft.co.uk/insights/" />
  <meta property="og:image" content="https://www.erssoft.co.uk/assets/logo.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Insights & Expertise | ERSSOFT Limited" />
  <meta name="twitter:description" content="ERSSOFT technical insights and articles on JD Edwards, ERP consulting, integration, business intelligence and artificial intelligence." />
  <meta name="twitter:image" content="https://www.erssoft.co.uk/assets/logo.png" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="stylesheet" href="/css/common.css"/><link rel="stylesheet" href="/css/header.css"/><link rel="stylesheet" href="/css/footer.css"/><link rel="stylesheet" href="/css/blog.css"/></head><body><Header/><main class="blog-wrap"><div class="blog-eyebrow">ERSSOFT INSIGHTS</div><h1>Insights &amp; Expertise</h1><p class="blog-intro">Practical knowledge and technical insights from enterprise technology projects.</p><nav class="insights-categories" aria-label="Article categories">{categories.map((category)=><button type="button" class="insights-category" data-category={category} aria-pressed={category==='All'?'true':'false'}>{category}</button>)}</nav><div class="insights-articles">{articles.map(article=><a class="blog-card" data-article-category={article.data.category} href={`/insights/${article.id}/`}><span class="blog-tag">{article.data.category}</span><h2>{article.data.title}</h2><p>{article.data.description}</p><span class="blog-read">Read article →</span></a>)}</div><p class="insights-empty" hidden>No articles in this category yet.</p></main><Footer/><script is:inline>document.querySelectorAll('.insights-category').forEach(button=>button.addEventListener('click',()=>{const category=button.dataset.category;document.querySelectorAll('.insights-category').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));let count=0;document.querySelectorAll('[data-article-category]').forEach(card=>{const visible=category==='All'||card.dataset.articleCategory===category;card.hidden=!visible;if(visible)count++;});document.querySelector('.insights-empty').hidden=count!==0;}));</script></body></html>
