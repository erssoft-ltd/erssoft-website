---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ErsSoft Limited | ERP & Manufacturing Systems Consulting</title>

  <!-- Theme & Icons -->
  <meta name="theme-color" content="#0b1020">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">

  <!-- SEO -->
  <meta name="description" content="ErsSoft Limited provides ERP, JD Edwards, manufacturing systems and data analytics consulting across the UK and internationally." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.erssoft.co.uk" />

  <!-- Open Graph -->
  <meta property="og:title" content="ErsSoft Limited | ERP & Manufacturing Systems Experts in the UK" />
  <meta property="og:description" content="UK-based ERP, JD Edwards and manufacturing systems consulting company delivering enterprise-grade solutions." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.erssoft.co.uk" />
  <meta property="og:image" content="https://www.erssoft.co.uk/assets/logo.png" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ErsSoft Limited",
    "url": "https://www.erssoft.co.uk",
    "logo": "https://www.erssoft.co.uk/assets/logo.png",
    "email": "info@erssoft.co.uk",
    "telephone": "+44 7518 630370",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "International House, 12 Constance Street",
      "addressLocality": "London",
      "postalCode": "E16 2DQ",
      "addressCountry": "GB"
    },
    "sameAs": [
      "https://find-and-update.company-information.service.gov.uk/company/13391504",
      "https://www.linkedin.com/company/77574975/"
    ]
  }
  </script>

  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/index.css">
</head>

<body>

<Header />

<section class="index-hero">
  <div>
     <h1>ERP & Manufacturing Systems Experts in the UK</h1>
    <p>
      ErsSoft Limited delivers enterprise-grade ERP, JD Edwards, manufacturing and data
      analytics solutions that help organizations operate smarter, faster and more efficiently
      across the UK and internationally.
    </p>
    <a href="/contact/" class="index-btn">Request a Consultation</a>
  </div>

  <div>
    <div class="index-card">
      <h3>Why ErsSoft?</h3>
      <p>
        With over 20 years of hands-on ERP and manufacturing systems experience,
        ErsSoft Limited helps organizations streamline operations, reduce costs
        and improve data-driven decision making.
      </p>
    </div>
  </div>
</section>

<section class="index-section">
  <h2>What We Do</h2>
  <p class="index-intro">
    We provide end-to-end consulting and implementation services across ERP,
    production systems, reporting and custom software development.
  </p>

  <div class="index-grid">
    <div class="index-card">
      <h3>ERP & JD Edwards</h3>
      <p>Implementation, upgrades, integrations and production support.</p>
    </div>

    <div class="index-card">
      <h3>Manufacturing Systems</h3>
      <p>Production planning, MRP, shop floor integration.</p>
    </div>

    <div class="index-card">
      <h3>Data & BI</h3>
      <p>Power BI dashboards and decision support systems.</p>
    </div>
  </div>
</section>

<Footer />

