---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import CookieConsent from "../components/CookieConsent.astro";
import corporate from "../data/corporate/en.json";
const expertise = [
  ["engineering", "Engineering & Production", "Manufacturing systems, fabrication workflows, quality and project execution.", "⚙"],
  ["business", "Business Solutions", "ERP (JD Edwards), planning and business process management.", "▤"],
  ["digital", "Digital Solutions", "Software development, integration and digitalisation.", "⌘"],
  ["data", "Data & Intelligence", "Data analytics, reporting and decision support.", "▥"]
];
const steps = [["Understand", "The business, challenges and goals."], ["Design", "Practical, fit-for-purpose solutions."], ["Deliver", "Implement, integrate and create value."], ["Improve", "Measure, learn and continually improve."]];
const docs = [
 ["Vision & Mission", "ERS-COR-001_Vision-Mission_Rev00_EN.pdf"],
 ["Core Values", "ERS-COR-002_Core-Values_Rev00_EN.pdf"],
 ["Guiding Principles", "ERS-COR-003_Guiding-Principles_Rev00_EN.pdf"],
 ["Quality & Service Management Policy", "ERS-POL-001_Quality-Service-Management_Rev00_EN.pdf"]
];
const valueIcons = ["◇", "✧", "◎", "✓", "↔", "✦", "≡", "↗", "♧"];
---
<!DOCTYPE html>
<html lang="en">
<head>
   <GoogleAnalytics />
  <title>About ErsSoft Limited | Business, Engineering & Technology</title>
  <meta name="description" content="Learn about ErsSoft Limited, a UK-based technology and consultancy company connecting business, engineering and digital expertise." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.erssoft.co.uk/about/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ERSSOFT Limited" />
  <meta property="og:title" content="About ErsSoft Limited | Business, Engineering & Technology" />
  <meta property="og:description" content="Learn about ErsSoft Limited, a UK-based technology and consultancy company connecting business, engineering and digital expertise." />
  <meta property="og:url" content="https://www.erssoft.co.uk/about/" />
  <meta property="og:image" content="https://www.erssoft.co.uk/assets/logo.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="About ErsSoft Limited | Business, Engineering & Technology" />
  <meta name="twitter:description" content="Learn about ErsSoft Limited, a UK-based technology and consultancy company connecting business, engineering and digital expertise." />
  <meta name="twitter:image" content="https://www.erssoft.co.uk/assets/logo.png" />
<meta charset="UTF-8">








<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">

<link rel="stylesheet" href="/css/common.css">
<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/footer.css">
<link rel="stylesheet" href="/css/about.css">
</head>

<body>

<Header />
<main class="ers-about">
<section class="ea-hero"><div class="ea-wrap"><span class="ea-kicker">About ErsSoft Limited</span><h1>Creating Value<br/>Through <em>Technology.</em></h1><p>Connecting business, engineering and technology to deliver practical and sustainable value.</p></div></section>
<section class="ea-wrap ea-section ea-intro"><div><span class="ea-kicker">Who we are</span><h2>Knowledge, experience<br/>and technology.</h2></div><div><p>We are a UK-based technology and consultancy company that brings together business experience, engineering knowledge and digital expertise.</p><p>Our focus is to understand real business needs and turn them into practical, reliable and valuable solutions.</p></div></section>
<section class="ea-direction"><img src="/assets/about/vision.webp" alt="Tower Bridge and the London skyline" loading="lazy"/><div class="ea-vision"><h2 class="ea-direction-title"><span class="ea-symbol" aria-hidden="true">◎</span>Our Vision</h2><p>{corporate["vision-mission"].items[0].text}</p></div><div class="ea-mission"><h2 class="ea-direction-title"><span class="ea-symbol" aria-hidden="true">↗</span>Our Mission</h2><p>{corporate["vision-mission"].items[1].text}</p></div></section>
<section class="ea-wrap ea-section"><span class="ea-kicker">What we do</span><div class="ea-heading"><h2>Our Areas of Expertise</h2><a href="/services/">Explore Our Services →</a></div><div class="ea-expertise">{expertise.map(([image,title,description,symbol]) => <article><img src={`/assets/about/${image}.webp`} alt="" loading="lazy"/><span class="ea-tile-icon" aria-hidden="true">{symbol}</span><h3>{title}</h3><p>{description}</p></article>)}</div></section>
<section class="ea-values"><div class="ea-wrap ea-section ea-values-inner"><div><span class="ea-kicker">Our Core Values</span><h2>What defines us.</h2><a href="/about/values/">Explore our values →</a></div><div class="ea-value-grid">{corporate.values.items.map((item,i)=><a href="/about/values/" title={item.text}><span aria-hidden="true">{valueIcons[i]}</span><strong>{item.title}</strong></a>)}</div></div></section>
<section class="ea-wrap ea-section ea-work"><div><span class="ea-kicker">How we work</span><h2>From understanding<br/>to lasting value.</h2><a href="/about/guiding-principles/">Our guiding principles →</a></div><ol>{steps.map(([title,description],i)=><li><span aria-hidden="true">{["⌕","◇","⚙","↗"][i]}</span><h3>{title}</h3><p>{description}</p></li>)}</ol></section>
<section class="ea-commitments"><article><h2>Quality &amp; Service Management</h2><p>A commitment to quality, reliability and continual improvement.</p><a href="/about/quality-policy/">Read our Policy →</a></article><article><h2>Trust &amp; Governance</h2><p>Doing business responsibly with integrity, accountability and transparency.</p><a href="/about/governance/">Our Approach →</a></article><article><h2>A Better World</h2><p>Better technology and smarter business decisions can help build a better world.</p><a href="/a-better-world/">Explore →</a></article></section>
<section class="ea-wrap ea-section"><span class="ea-kicker">Corporate Documents</span><h2>Our commitments in writing.</h2><div class="ea-docs">{docs.map(([title,file])=><article><span class="ea-doc-icon" aria-hidden="true">▤</span><h3>{title}</h3><div><a href={`/documents/corporate/${file}`} target="_blank" rel="noopener noreferrer" aria-label={`View ${title} PDF`}>View PDF</a><a href={`/documents/corporate/${file}`} download aria-label={`Download ${title} PDF`}>Download ↓</a></div></article>)}</div></section>
</main>
<Footer />
<CookieConsent />
</body></html>
